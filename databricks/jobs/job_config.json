{
  "name": "fraud-platform-medallion-etl",
  "tags": {
    "project": "fraud-platform",
    "layer": "bronze-silver-gold"
  },
  "job_clusters": [
    {
      "job_cluster_key": "etl_cluster",
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "policy_id": "{{cluster_policy_id}}",
        "autoscale": { "min_workers": 1, "max_workers": 8 },
        "azure_attributes": {
          "availability": "SPOT_WITH_FALLBACK_AZURE",
          "first_on_demand": 1
        },
        "spark_conf": {
          "spark.databricks.delta.optimizeWrite.enabled": "true",
          "spark.databricks.delta.autoCompact.enabled": "true"
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "bronze_ingestion",
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/fraud-platform/databricks/notebooks/01_bronze_ingestion",
        "base_parameters": { "storage_account": "{{storage_account}}" }
      }
    },
    {
      "task_key": "silver_transformations",
      "depends_on": [{ "task_key": "bronze_ingestion" }],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/fraud-platform/databricks/notebooks/02_silver_transformations",
        "base_parameters": { "storage_account": "{{storage_account}}" }
      }
    },
    {
      "task_key": "gold_aggregations",
      "depends_on": [{ "task_key": "silver_transformations" }],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/fraud-platform/databricks/notebooks/03_gold_aggregations",
        "base_parameters": { "storage_account": "{{storage_account}}" }
      }
    },
    {
      "task_key": "fraud_feature_engineering",
      "depends_on": [{ "task_key": "silver_transformations" }],
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/fraud-platform/databricks/notebooks/04_feature_engineering",
        "base_parameters": { "storage_account": "{{storage_account}}" }
      }
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 5 * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "email_notifications": {
    "on_failure": ["data-eng-alerts@example.com"]
  },
  "max_concurrent_runs": 1
}
